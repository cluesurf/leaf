{
  "compilerOptions": {
    "module": "ESNext",
    "target": "ES2022",
    "lib": ["es2022", "dom"],
    "outDir": "host",
    "rootDir": "code",
    "sourceMap": true,
    "inlineSources": true,
    "declaration": true,
    "moduleResolution": "bundler",
    "strict": true,
    "strictNullChecks": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noUncheckedIndexedAccess": true,
    "allowJs": false,
    "noErrorTruncation": true,
    "noImplicitAny": false,
    "ignoreDeprecations": "6.0",
    "types": ["node"],
    "typeRoots": ["node_modules/@types"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./code/*"]
    }
  },
  "include": ["code/**/*.ts"],
  "exclude": [
    "node_modules",
    "**/node_modules",
    "host",
    "test",
    "text",
    "out",
    "**/*.test.ts",
    "**/*.spec.ts"
  ]
}
