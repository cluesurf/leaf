{
  "name": "@cluesurf/leaf",
  "version": "0.10.2",
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "description": "A Template Language \u16c9",
  "type": "module",
  "main": "./host/index.js",
  "types": "./host/index.d.ts",
  "exports": {
    ".": {
      "types": "./host/index.d.ts",
      "default": "./host/index.js"
    },
    "./save": {
      "types": "./host/save/index.d.ts",
      "default": "./host/save/index.js"
    },
    "./extract": {
      "types": "./host/extract.d.ts",
      "default": "./host/extract.js"
    },
    "./book": {
      "types": "./host/book/index.d.ts",
      "default": "./host/book/index.js"
    },
    "./kink": {
      "types": "./host/kink.d.ts",
      "default": "./host/kink.js"
    }
  },
  "files": [
    "host",
    "readme.md",
    "license.md"
  ],
  "scripts": {
    "test": "pnpm exec vitest run",
    "make:base": "pnpm exec tsx task/save.ts",
    "make": "pnpm make:base && rm -rf host && pnpm exec tsc --project tsconfig.json --pretty && rm -f tsconfig.tsbuildinfo && pnpm exec tsc-alias --project tsconfig.json --resolve-full-paths",
    "host": "pnpm make && pnpm publish --access=public --no-git-checks"
  },
  "prettier": "@cluesurf/wash/flow.json",
  "dependencies": {
    "@formatjs/intl": "catalog:",
    "p-limit": "catalog:",
    "prettier": "catalog:"
  },
  "devDependencies": {
    "@cluesurf/wash": "catalog:",
    "@types/fs-extra": "catalog:",
    "@types/node": "catalog:",
    "@types/yargs": "catalog:",
    "concurrently": "catalog:",
    "dotenv": "catalog:",
    "fs-extra": "catalog:",
    "js-yaml": "catalog:",
    "ts-node": "catalog:",
    "tsc-alias": "catalog:",
    "tsx": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "ts-morph": "catalog:",
    "yaml": "catalog:",
    "yargs": "catalog:"
  },
  "peerDependencies": {
    "react": "catalog:",
    "@cluesurf/kink": "catalog:"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "optionalDependencies": {
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  }
}
